//Device Version: B
//Created Time: Sun 10 11 17:06:00 2026
// 2026-10-19 V3: all 14 PCB3 signals use J14 pins 1-10 and 13-16.
// PCB3 GND uses J14-12; 3.3V stays on J9-1. Never use J14-11 (5V).
// J14 pins 1-8 alias PMOD0; no separate load may use the same nets.
// Keep CPU as regular IO enabled for CSI_B (V17) and D09/D10 (W21/W22).

IO_LOC "pa_en" AB16;
IO_PORT "pa_en" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "dac_din" AA16;
IO_PORT "dac_din" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "dac_ws" AB17;
IO_PORT "dac_ws" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "dac_bck" Y17;
IO_PORT "dac_bck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "dark_led" W22; // J14 pin 13, red status LED / control PCB P1 pin 6.
IO_PORT "dark_led" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "transpose_led[9]" V17; // J14 pin 10, outermost right LED / P1 pin 16.
IO_PORT "transpose_led[9]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "transpose_led[8]" W17; // J14 pin 9, fourth right LED / P1 pin 14.
IO_PORT "transpose_led[8]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "transpose_led[7]" T18; // J14 pin 7, same FPGA net as PMOD0.
IO_PORT "transpose_led[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "transpose_led[6]" R18; // J14 pin 8, same FPGA net as PMOD0.
IO_PORT "transpose_led[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "transpose_led[5]" R17; // J14 pin 5, same FPGA net as PMOD0.
IO_PORT "transpose_led[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "transpose_led[4]" P16; // J14 pin 6, same FPGA net as PMOD0.
IO_PORT "transpose_led[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "transpose_led[3]" U21; // J14 pin 3, same FPGA net as PMOD0.
IO_PORT "transpose_led[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "transpose_led[2]" T21; // J14 pin 4, same FPGA net as PMOD0.
IO_PORT "transpose_led[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "transpose_led[1]" R19; // J14 pin 1, same FPGA net as PMOD0.
IO_PORT "transpose_led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "transpose_led[0]" P19; // J14 pin 2, same FPGA net as PMOD0.
IO_PORT "transpose_led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "adc_mosi" AB21;
IO_PORT "adc_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "adc_sck" Y21;
IO_PORT "adc_sck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "adc_cs_n" Y22;
IO_PORT "adc_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "dark_button_n" W21; // J14 pin 14, active-low dark button / P1 pin 5.
IO_PORT "dark_button_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "enc_b" N17; // J14 pin 16, encoder B / control PCB P1 pin 4.
IO_PORT "enc_b" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "enc_a" P17; // J14 pin 15, encoder A / control PCB P1 pin 3.
IO_PORT "enc_a" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "adc_miso[0]" AB22;
IO_PORT "adc_miso[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC "rst_n" Y12;
IO_PORT "rst_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
IO_LOC "sys_clk" V22;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// HDMI uses fixed NEO Dock traces; no PCB2/PCB3 wire changes.
IO_LOC "tmds_data_p[0]" J14,H14;
IO_PORT "tmds_data_p[0]" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_LOC "tmds_data_p[1]" J15,H15;
IO_PORT "tmds_data_p[1]" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_LOC "tmds_data_p[2]" K17,J17;
IO_PORT "tmds_data_p[2]" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_LOC "tmds_clk_p" G15,G16;
IO_PORT "tmds_clk_p" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_LOC "hpd_en" K13;
IO_PORT "hpd_en" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=12 BANK_VCCIO=3.3;
INS_LOC "u_system/u_video_pll/PLLA_inst" PLL_R[0];

// 28键：共享CS/SCK/MOSI；四路独立MISO。未接ADC时下拉为零。
IO_LOC "adc_miso[1]" AA20;
IO_PORT "adc_miso[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC "adc_miso[2]" AA21;
IO_PORT "adc_miso[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC "adc_miso[3]" AA19;
IO_PORT "adc_miso[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

// PCB4灯板：J8-6 / PMOD1_IO7 / CAM0_PCLK / AB20，原有36球位保持不变。
// J14-27（SDRAM1_WE）也是同一根AB20网络，不能再接其他信号。
// 仅接U2-3数据；U2-2共地；灯板5V由P1独立供电，不经GPIO供电。
// 同网摄像头/SDRAM扩展接口保持空置，不能再接另一输出源。
IO_LOC "key_led_data" AB20;
IO_PORT "key_led_data" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4 SLEW_RATE=SLOW BANK_VCCIO=3.3;

// D6：USB1只读，原M15/M16位置不动；按D5实测信号选择USB2作为主机线路。
IO_LOC "usb1_dp" M15;
IO_PORT "usb1_dp" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "usb1_dm" M16;
IO_PORT "usb1_dm" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// USB2：SW4朝FPGA，板上已有15k下拉；双向IOBUF默认高阻，长按后才允许主机驱动。
IO_LOC "usb2_dp" H13;
IO_PORT "usb2_dp" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 SLEW_RATE=SLOW BANK_VCCIO=3.3;
IO_LOC "usb2_dm" G13;
IO_PORT "usb2_dm" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 SLEW_RATE=SLOW BANK_VCCIO=3.3;

// D9原生TF卡SPI：官方60K球位及NEO31005第16页交叉核对。六位DIP第5/6位保持ON（JTAG/EVB），BL616 SPI高阻。
IO_LOC "sd_miso" AA15;
IO_PORT "sd_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "sd_sck" V15;
IO_PORT "sd_sck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 SLEW_RATE=SLOW BANK_VCCIO=3.3;
IO_LOC "sd_cs_n" W15;
IO_PORT "sd_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 SLEW_RATE=SLOW BANK_VCCIO=3.3;
IO_LOC "sd_mosi" Y16;
IO_PORT "sd_mosi" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 SLEW_RATE=SLOW BANK_VCCIO=3.3;

// D12 CH569既有HSPI连线：未身份握手前数据输出高阻，不接外部排针。
IO_LOC "ch_ready" K21;
IO_PORT "ch_ready" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "ch_rx_req" N18;
IO_PORT "ch_rx_req" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "ch_tx_ack" G18;
IO_PORT "ch_tx_ack" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "ch_rx_data[0]" G17;
IO_PORT "ch_rx_data[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "ch_rx_data[1]" H22;
IO_PORT "ch_rx_data[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "ch_rx_data[2]" L14;
IO_PORT "ch_rx_data[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "ch_rx_data[3]" K22;
IO_PORT "ch_rx_data[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "ch_rx_ack" J21;
IO_PORT "ch_rx_ack" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "ch_tx_req" J20;
IO_PORT "ch_tx_req" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "ch_tx_data[0]" K18;
IO_PORT "ch_tx_data[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "ch_tx_data[1]" L21;
IO_PORT "ch_tx_data[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "ch_tx_data[2]" M21;
IO_PORT "ch_tx_data[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "ch_tx_data[3]" N19;
IO_PORT "ch_tx_data[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// D13 标准I2S独立输出；J13不得同时插SDRAM0扩展板，GND=J13-12。
IO_LOC "i2s_bclk" E14; // J13-1
IO_PORT "i2s_bclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 SLEW_RATE=SLOW BANK_VCCIO=3.3;
IO_LOC "i2s_lrclk" E13; // J13-2
IO_PORT "i2s_lrclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 SLEW_RATE=SLOW BANK_VCCIO=3.3;
IO_LOC "i2s_data" C15; // J13-3
IO_PORT "i2s_data" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 SLEW_RATE=SLOW BANK_VCCIO=3.3;
